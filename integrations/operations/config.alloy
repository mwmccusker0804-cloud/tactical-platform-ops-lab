local.file_match "training" {
  path_targets = [{__path__ = "/events/*.jsonl", job = "tpol-operations"}]
}
loki.source.file "training" {
  targets    = local.file_match.training.targets
  forward_to = [loki.write.lab.receiver]
}
loki.write "lab" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
