<group name="tpol,">
  <rule id="100100" level="3">
    <decoded_as>json</decoded_as>
    <field name="source">^tpol-bridge$</field>
    <description>Tactical lab connector event</description>
  </rule>
  <rule id="100101" level="6">
    <if_sid>100100</if_sid>
    <field name="event">^authorization$</field>
    <field name="outcome">^denied$</field>
    <description>Tactical lab connector authorization denied</description>
  </rule>
  <rule id="100102" level="5">
    <if_sid>100100</if_sid>
    <field name="event">^lab-action$</field>
    <field name="outcome">^completed$</field>
    <description>Tactical lab operation completed; review authorized change context</description>
  </rule>
</group>
